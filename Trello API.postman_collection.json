    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the response body",
              "const jsonData = pm.response.json();",
              "",
              "// Validate HTTP Status Code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Check if the board ID exists in the response",
              "pm.test(\"Check if id exists\", function () {",
              "    pm.expect(jsonData.id).to.exist;",
              "});",
              "",
              "// Verify that the created Board Name matches the requested name",
              "pm.test(\"Correct Board Name\", function () {",
              "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get(\"boardName\"));",
              "});",
              "",
              "// Save the generated Board ID to collection variable for the next API",
              "if (pm.response.code === 200 && jsonData.id) {",
              "    pm.collectionVariables.set(\"boardID\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate a random 3-digit number padded with leading zeros",
              "const randomNum = Math.floor(Math.random() * 1000)",
              "  .toString()",
              "  .padStart(3, '0');",
              "",
              "// Save the unique board name to collection variable to prevent conflicts",
              "pm.collectionVariables.set(\"boardName\", `myboard${randomNum}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
