    {
      "name": "Get Created Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the response body",
              "const jsonData = pm.response.json();",
              "",
              "// Validate HTTP Status Code",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verify that the retrieved board is active",
              "pm.test(\"Board is active and not closed\", function () {",
              "    pm.expect(jsonData.closed).to.eql(false);",
              "});",
              "",
              "// Data Integrity: Cross-check ID and Name with stored collection variables",
              "const savedBoardID = pm.collectionVariables.get(\"boardID\");",
              "const savedBoardName = pm.collectionVariables.get(\"boardName\");",
              "",
              "pm.test(\"Retrieved Board ID matches the created Board ID\", function () {",
              "    pm.expect(jsonData.id).to.eql(savedBoardID);",
              "});",
              "",
              "pm.test(\"Retrieved Board Name matches the created Board Name\", function () {",
              "    pm.expect(jsonData.name).to.eql(savedBoardName);",
              "});"
            ],
